{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Cortex.Windows/Database",
  "version": "0.1.0",
  "description": "Cortex roles, database, extensions and immutable, hash tracked migrations.",
  "tags": [
    "cortex",
    "windows"
  ],
  "get": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "Database",
      "-Operation",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "Database",
      "-Operation",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "Database",
      "-Operation",
      "set"
    ],
    "input": "stdin",
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "1": "Error, see stderr and steps.jsonl"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "database",
        "ownerRole",
        "appRole",
        "extensions",
        "migrationsDir",
        "pgInstallDir",
        "port"
      ],
      "properties": {
        "database": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string"
        },
        "appRole": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrationsDir": {
          "type": "string"
        },
        "pgInstallDir": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "installedExtensions": {
          "type": "array",
          "readOnly": true
        },
        "appliedMigrations": {
          "type": "array",
          "readOnly": true
        },
        "pendingMigrations": {
          "type": "array",
          "readOnly": true
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "_inDesiredState": {
          "type": [
            "boolean",
            "null"
          ],
          "readOnly": true
        }
      }
    }
  }
}
