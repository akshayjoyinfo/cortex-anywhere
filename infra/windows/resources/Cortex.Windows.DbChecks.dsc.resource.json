{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Cortex.Windows/DbChecks",
  "version": "0.1.0",
  "description": "Database isolation invariants (db/checks) pass on a throwaway copy of the schema.",
  "tags": [
    "cortex",
    "windows"
  ],
  "get": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "DbChecks",
      "-Operation",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "DbChecks",
      "-Operation",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "C:\\Program Files\\Cortex\\provisioning\\resources\\cortex-dsc.ps1",
      "-Resource",
      "DbChecks",
      "-Operation",
      "set"
    ],
    "input": "stdin",
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "1": "Error, see stderr and steps.jsonl"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "checks",
        "checksDir",
        "migrationsDir",
        "ownerRole",
        "extensions",
        "pgInstallDir",
        "port"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "expect"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "expect": {
                "type": "string",
                "enum": [
                  "empty",
                  "success"
                ]
              }
            }
          }
        },
        "checksDir": {
          "type": "string"
        },
        "migrationsDir": {
          "type": "string"
        },
        "ownerRole": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pgInstallDir": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "passed": {
          "type": "integer",
          "readOnly": true
        },
        "failed": {
          "type": "array",
          "readOnly": true
        },
        "results": {
          "type": "array",
          "readOnly": true
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "_inDesiredState": {
          "type": [
            "boolean",
            "null"
          ],
          "readOnly": true
        }
      }
    }
  }
}
